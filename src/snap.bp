//// snap — the snapshot engine every `<lib>-test` writes through (decisions 72,
//// 73, 67; moved from std's `testing/snapshots.bp` by decision 391).
////
//// Three rules:
////   1. `path(loc)` = `<dir of loc.file>/__snapshots__/<suite>/<slug>.snap`,
////      where `suite` is the text before the first `": "` of the test name
////      and `slug` is the slugified rest — the slugifier is byte-for-byte the
////      compiler's own (`codegen/tests/helpers.zig` `slugify`): lowercase,
////      every maximal run of `[A-Za-z0-9]` kept, everything else one `_`,
////      no leading or trailing `_`.
////   2. A mismatch or a missing file writes `<path>.new` and answers `Error`.
////      Nothing accepts a snapshot but a person renaming the `.new` file:
////      there is no update flag, no environment variable, no manifest key
////      (decision 67), and no code path here ever writes `<path>` itself.
////   3. A `<lib>-test` exposes `assert<Subject>(syntax value: unknown) -> anyvalue`
////      helpers (decision 719) that turn a domain value into text and answer
////      `matchesAsAt("<subject>", text, at)` with the CALLER's `Place`,
////      read by `compiler.source(value)` where the helper is called.
////
//// The `.snap` file (decision 72):
////
////     botopink-snap 1
////     test: <loc.fnName>
////     subject: <subject>
////     <empty line>
////     <body, verbatim, one trailing newline appended>
////
//// Header lines compare exactly; bodies compare after `\r\n → \n` and with
//// trailing newlines trimmed on both sides — the two normalisations the
//// compiler's `utils/snap.zig` applies — and nothing else.
////
//// `path`, `pathNamed`, `suiteOf` and `slugOf` are pure botopink. The four
//// `matches*At` entry points read and write through `io/fs` and `path`, imported
//// below — the library declares no host cell. So it runs where `io/fs` runs —
//// commonJS, erlang and beam — and is no loss on wasm (`io/fs` has no wasm
//// binding): `botopink test` runs on commonJS and erlang only. `path(loc)` is
//// package-relative because `loc.file` is; the engine opens it relative to
//// the process's working directory, and `botopink test` runs from the
//// package root.
////
//// `io/process` is bound as `host`, because a module-level `process` shadows
//// Node's global in the emitted file, and `io/random` is not imported at all.
//// Consumers write `import {snap} from "snap";` and `snap.matches(render(page));`.

import {failure.panic, io.fs, io.os, io.env, io.process as host, path.join as joinPath, path.dirname as parentOf, compiler, compiler.Source, compiler.Node, compiler.Call, compiler.Name, compiler.Lit, compiler.Syntax} from "std";

// ── the path rule (pure) ─────────────────────────────────────────────────────

// The suite of a test name: the text before the first `": "`, `""` when the
// name has none (`matches*` then refuse — decision 67, no `misc/` default).
pub fn suiteOf(testName: string) -> string {
    val i = testName.indexOf(": ");
    if (i < 0) return "";
    return testName.slice(0, i);
}

// The rest of a test name after its suite, `""` when there is no suite.
fn descriptionOf(testName: string) -> string {
    val i = testName.indexOf(": ");
    if (i < 0) return "";
    return testName.slice(i + 2, testName.length());
}

// A character lowercased when it is `[A-Za-z0-9]`, `""` otherwise — the one
// classification `slugOf` needs, written over `indexOf` so it is the same on
// every host (no `toLower`, no char codes).
fn slugChar(c: string) -> string {
    val upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    val lower = "abcdefghijklmnopqrstuvwxyz0123456789";
    val u = upper.indexOf(c);
    if (u >= 0) return lower.slice(u, u + 1);
    if (lower.indexOf(c) >= 0) return c;
    return "";
}

// `slugOf`'s walk: `acc` is the slug so far, `pending` whether a separator
// is owed before the next kept character (never flushed at the end, so no
// trailing `_`; never before an empty `acc`, so no leading one).
fn slugStep(chars: string[], i: i32, acc: string, pending: bool) -> string {
    if (i >= chars.length) return acc;
    val c = chars.slice(i, i + 1).join("");
    val kept = slugChar(c);
    if (kept == "") return slugStep(chars, i + 1, acc, true);
    val glue = if (pending && acc != "") "_" else "";
    return slugStep(chars, i + 1, [acc, glue, kept].join(""), false);
}

// The slugify rule (`codegen/tests/helpers.zig:38`, byte-for-byte):
// `"Modifiers ---- Hover, on (md) breakpoint!"` → `modifiers_hover_on_md_breakpoint`.
pub fn slugOf(text: string) -> string {
    return slugStep(text.split(""), 0, "", false);
}

// The directory of a `/`-separated path, `""` for a bare file name.
fn dirOf(file: string) -> string {
    val parts = file.split("/");
    val n = parts.length;
    if (n <= 1) return "";
    return parts.slice(0, n - 1).join("/");
}

// `<dir of loc.file>/__snapshots__/<suite>/` — the directory rule 1 fixes.
fn snapshotDir(loc: SourceLocation) -> string {
    val dir = dirOf(loc.file);
    val root = if (dir == "")
        "__snapshots__"
    else
        [dir, "/__snapshots__"].join("");
    return [root, "/", slugOf(suiteOf(loc.fnName)), "/"].join("");
}

// The `.snap` path of the test `loc` was taken in. Pure; every backend. A
// `loc` whose name has no `": "` (or is `""`, module level) has no suite: the
// path is then `<dir>/__snapshots__//<slug>.snap`-shaped garbage, which is
// why `assert*` refuse such a name before computing it.
pub fn path(loc: SourceLocation) -> string {
    return [snapshotDir(loc), slugOf(descriptionOf(loc.fnName)), ".snap"].join(
        "",
    );
}

// A second snapshot of the same test: `…/<slug>.<slugOf(name)>.snap`.
pub fn pathNamed(loc: SourceLocation, name: string) -> string {
    return [
        snapshotDir(loc),
        slugOf(descriptionOf(loc.fnName)),
        ".",
        slugOf(name),
        ".snap",
    ].join("");
}

// ── the filesystem, through `io/fs` and `path` ────────────────────────────────
// The engine has no host cell of its own (1.0.11-beta front 97): it reads with
// `fs.readText`, writes with `fs.writeText`, asks `fs.exists`, removes with
// `fs.rm`, and its inline tests clear their scratch directories with
// `fs.removeTree`.

// Make `dir` and every missing directory above it. `""` (the parent of a bare
// name) is done at once; a directory that is already there is `Ok` too.
fn ensureDir(dir: string) -> Result<void, string> {
    if (dir == "") return;
    val made = fs.mkdirRecursive(dir);
    if (made.isError()) throw fsErrorText(made);
    return;
}

// The `FsError` text of an `io.fs` result, `""` for `Ok`.
fn fsErrorText<T>(r: Result<T, fs.FsError>) -> string {
    val text = case r {
        Ok(v) -> "";
        Error(e) -> e.message();
    };
    return text;
}

// Write `text` to `p`, creating the parent directories; the host's error
// on failure (a full disk is a test failure, not a silent pass).
fn writeFile(p: string, text: string) -> Result<i32, string> {
    try ensureDir(parentOf(p));
    val written = fs.writeText(p, text);
    if (written.isError()) throw fsErrorText(written);
    return written.unwrapOr(0);
}

// Remove `p`; a file that is not there is `Ok` too.
fn removeFile(p: string) -> Result<i32, string> {
    if (fs.exists(p) == false) return 0;
    val removed = fs.rm(p);
    if (removed.isError()) throw fsErrorText(removed);
    return removed.unwrapOr(0);
}

// The first `<base>/bpsnap-<pid>-<n>` that is not there yet, counting from
// `n`. The pid tells two test processes of one run apart; the count tells
// this process's own directories apart, and steps over one an earlier run
// with the same pid left behind.
fn freeScratch(base: string, n: i32) -> string {
    val name = ["bpsnap-", host.pid().toString(), "-", n.toString()].join("");
    val dir = joinPath([base, name]);
    return if (fs.exists(dir)) freeScratch(base, n + 1) else dir;
}

// A fresh, empty scratch directory — for the inline tests only, so the
// package tree is never written to; each test removes it again with
// `fs.removeTree`. Under `BOTOPINK_TEST_TMPDIR` (the per-run directory
// `botopink test` names and removes with the run) and, outside a test run,
// under the host's tmpdir.
fn tmpDir() -> string {
    val base = env.read("BOTOPINK_TEST_TMPDIR") ?? os.tmpdir();
    val dir = freeScratch(base, 0);
    val made = ensureDir(dir);
    return if (made.isOk()) dir else "";
}

// ── the engine ───────────────────────────────────────────────────────────────

// The file text of a snapshot: header, blank line, body, one newline.
fn render(testName: string, subject: string, body: string) -> string {
    return [
        "botopink-snap 1\ntest: ",
        testName,
        "\nsubject: ",
        subject,
        "\n\n",
        body,
        "\n",
    ].join("");
}

// The `Error` payload of a cell's result, `""` for `Ok`.
fn errorOf(r: Result<i32, string>) -> string {
    val text = case r {
        Ok(v) -> "";
        Error(e) -> e;
    };
    return text;
}

// The `Error` payload of an engine result, `""` for `Ok` — what a test reads
// to check a refusal (`asserts.errorText`'s twin, private: a std module does
// not import another).
fn errorText<T>(r: Result<T, string>) -> string {
    val text = case r {
        Ok(v) -> "";
        Error(e) -> e;
    };
    return text;
}

// How a recorded file compares with what the test produced: `""` for a
// match, otherwise the parenthesised reason of the mismatch message, or
// `"not a snapshot file"` when the magic line is wrong.
fn verdict(
    recorded: string,
    testName: string,
    subject: string,
    actual: string,
) -> string {
    val lines = recorded.normalizeNewlines().split("\n");
    if (lines.length < 4) return "not a snapshot file";
    if (lines.slice(0, 1).join("") != "botopink-snap 1")
        return "not a snapshot file";
    val headerOk = lines.slice(1, 4).join("\n")
        == ["test: ", testName, "\nsubject: ", subject, "\n"].join("");
    if (headerOk == false) return "(header differs)";
    val recordedBody = lines
        .slice(4, lines.length)
        .join("\n")
        .trimTrailingNewlines();
    val actualBody = actual.normalizeNewlines().trimTrailingNewlines();
    if (recordedBody == actualBody) return "";
    val n = recordedBody.firstDifferingLine(actualBody);
    return ["(first difference at body line ", n.toString(), ")"].join("");
}

// Write the candidate `<path>.new`; a host failure is the test's failure.
fn writeCandidate(newPath: string, text: string) -> Result<void, string> {
    val w = writeFile(newPath, text);
    if (w.isError())
        throw ["snapshots: cannot write ", newPath, ": ", errorOf(w)].join("");
    return;
}

// The engine proper, over a computed `file` path.
fn check(
    loc: SourceLocation,
    file: string,
    subject: string,
    actual: string,
) -> Result<void, string> {
    val expected = render(loc.fnName, subject, actual);
    val newPath = [file, ".new"].join("");
    val recorded = fs.readText(file);
    if (recorded.isError()) {
        try writeCandidate(newPath, expected);
        throw [
            "snapshots: missing ",
            file,
            " - candidate written to ",
            newPath,
            "; review it and rename it to record",
        ].join("");
    }
    val why = verdict(recorded.unwrapOr(""), loc.fnName, subject, actual);
    if (why == "not a snapshot file")
        throw ["snapshots: not a snapshot file: ", file].join("");
    if (why != "") {
        try writeCandidate(newPath, expected);
        throw [
            "snapshots: mismatch ",
            file,
            " - candidate written to ",
            newPath,
            " ",
            why,
        ].join("");
    }
    // A match: a stale `.new` from an earlier red run is review noise.
    val cleared = removeFile(newPath);
    if (cleared.isError())
        throw [
            "snapshots: cannot remove ",
            newPath,
            ": ",
            errorOf(cleared),
        ].join("");
    return;
}

// Refuse a `loc` whose test name carries no suite (decision 67: no default).
fn requireSuite(loc: SourceLocation) -> Result<void, string> {
    if (loc.fnName == "")
        throw "snapshots: test name needs a suite - a call made outside a running test has no test name; make it inside test \"<suite>: <description>\" { ... }";
    if (suiteOf(loc.fnName) == "")
        throw "snapshots: test name needs a suite - write \"<suite>: <description>\"";
    return;
}

// ── the engine's placing core ────────────────────────────────────────────────
// `loc` names the test (`loc.fnName`) and the file beside which the snapshot
// lives; the public functions below build it from the `Source` the call
// expansion wrote.

// Record/compare `actual` as the test's one snapshot, with `subject` in the header.
fn placeAs(
    loc: SourceLocation,
    subject: string,
    actual: string,
) -> Result<void, string> {
    try requireSuite(loc);
    try check(loc, path(loc), subject, actual);
    return;
}

// A named snapshot with a subject. `name` empty is refused.
fn placeNamedAs(
    loc: SourceLocation,
    name: string,
    subject: string,
    actual: string,
) -> Result<void, string> {
    try requireSuite(loc);
    if (slugOf(name) == "")
        throw "snapshots: a named snapshot needs a name - pass a non-empty name to matchesNamed/matchesNamedAs";
    try check(loc, pathNamed(loc, name), subject, actual);
    return;
}

// The environment variable through which the test harness names the running
// test (decision 772): `botopink test`'s runner sets it before each test body
// and clears it after, so the name is a run-time value of the harness.
val testNameEnv = "BOTOPINK_TEST_NAME";

// The name of the test running now, `""` outside a test run.
fn runningTest() -> string {
    return env.read(testNameEnv) ?? "";
}

// A call's place, as the expansion writes it: the file relative to the
// package root (decision 756), the line and the column. It stands for std's
// `compiler.Source` at run time, which no target can build yet (`__Source`
// is undefined on erlang and commonJS, machine 2's B-147).
pub type Place(file: string, line: i32, col: i32)

// The `SourceLocation` of a call: the file the expansion wrote (decision 756)
// places the snapshot, the running test's name (decision 772) names it.
fn locationOf(at: Place) -> SourceLocation {
    return SourceLocation(file: at.file, line: at.line, column: at.col, fnName: runningTest());
}

// ── the public functions (decision 719) ──────────────────────────────────────
// Each is expanded at its call: the test writes `snap.matches(render(page));`
// and the expansion answers the run-time call with the expression as written
// (`Syntax(value)`) and the call's `Source`. The tree's names are this
// module's (decision 638), so the caller imports nothing but `snap`.

// The call's `Source` as code: `placeAt("<file>", <line>, <col>)`.
fn sourceNode(at: Source) -> Node {
    return Call(callee: Name("placeAt"), args: [Lit(at.file), Lit(at.line), Lit(at.col)]);
}

// Record/compare `value` as the test's one snapshot (subject `text`).
pub fn matches(syntax value: unknown) -> anyvalue {
    val at = compiler.source(value);
    return compiler.ast(Call(callee: Name("matchesAt"), args: [Syntax(value), sourceNode(at)]));
}

// The same, with the helper's subject (`css`, `html`, `route`, …) in the header.
pub fn matchesAs(comptime subject: string, syntax value: unknown) -> anyvalue {
    val at = compiler.source(value);
    return compiler.ast(Call(callee: Name("matchesAsAt"), args: [Lit(subject), Syntax(value), sourceNode(at)]));
}

// A named second snapshot in the same test, subject `text`.
pub fn matchesNamed(comptime name: string, syntax value: unknown) -> anyvalue {
    val at = compiler.source(value);
    return compiler.ast(Call(callee: Name("matchesNamedAt"), args: [Lit(name), Syntax(value), sourceNode(at)]));
}

// A named snapshot with a subject.
pub fn matchesNamedAs(
    comptime name: string,
    comptime subject: string,
    syntax value: unknown,
) -> anyvalue {
    val at = compiler.source(value);
    return compiler.ast(Call(callee: Name("matchesNamedAsAt"), args: [Lit(name), Lit(subject), Syntax(value), sourceNode(at)]));
}

// ── the run-time calls the expansions answer ─────────────────────────────────

// A `Place`, written by the expansion at the call site.
pub fn placeAt(file: string, line: i32, col: i32) -> Place {
    return Place(file: file, line: line, col: col);
}

// The text a snapshot records: the value the test passed, a string.
fn textOf(value: unknown) -> Result<string, string> {
    if (value is string) return value;
    throw "snapshots: a snapshot records a string - pass the text, not another value";
}

pub fn matchesAt(value: unknown, at: Place) -> void {
    val text = textOf(value);
    if (text.isError()) panic(errorText(text));
    val r = placeAs(locationOf(at), "text", text.unwrapOr(""));
    if (r.isError()) panic(errorText(r));
    return;
}

pub fn matchesAsAt(subject: string, value: unknown, at: Place) -> void {
    val text = textOf(value);
    if (text.isError()) panic(errorText(text));
    val r = placeAs(locationOf(at), subject, text.unwrapOr(""));
    if (r.isError()) panic(errorText(r));
    return;
}

pub fn matchesNamedAt(name: string, value: unknown, at: Place) -> void {
    val text = textOf(value);
    if (text.isError()) panic(errorText(text));
    val r = placeNamedAs(locationOf(at), name, "text", text.unwrapOr(""));
    if (r.isError()) panic(errorText(r));
    return;
}

pub fn matchesNamedAsAt(
    name: string,
    subject: string,
    value: unknown,
    at: Place,
) -> void {
    val text = textOf(value);
    if (text.isError()) panic(errorText(text));
    val r = placeNamedAs(locationOf(at), name, subject, text.unwrapOr(""));
    if (r.isError()) panic(errorText(r));
    return;
}

// ── the location-taking entry points, kept until their consumers move ────────
// `assertText`, `assertAs`, `assertNamed` and `assertNamedAs` take the
// caller's `SourceLocation` (`comptime compiler.src()`, decision 718 (b)) and
// answer `Result<void, string>`; each delegates to the engine above. The
// `<lib>-test` helpers still call them; they go once those helpers are
// written over `matchesAs` (front 160).

pub fn assertText(loc: SourceLocation, actual: string) -> Result<void, string> {
    try placeAs(loc, "text", actual);
    return;
}

pub fn assertAs(
    loc: SourceLocation,
    subject: string,
    actual: string,
) -> Result<void, string> {
    try placeAs(loc, subject, actual);
    return;
}

pub fn assertNamed(
    loc: SourceLocation,
    name: string,
    actual: string,
) -> Result<void, string> {
    try placeNamedAs(loc, name, "text", actual);
    return;
}

pub fn assertNamedAs(
    loc: SourceLocation,
    name: string,
    subject: string,
    actual: string,
) -> Result<void, string> {
    try placeNamedAs(loc, name, subject, actual);
    return;
}

// ── tests ────────────────────────────────────────────────────────────────────
// The path rule is recorded as ordinary snapshots beside this file
// (`src/__snapshots__/snapshots/…`, `test-snap.md`); the engine tests itself
// against a scratch directory under the host tmpdir, building a
// `SourceLocation` by hand whose `file` points there, so the package tree is
// untouched and every outcome is produced deterministically.

test "snapshots: path ---- suite and slug from a test name" {
    val loc = SourceLocation(
        file: "src/emilia.bp",
        line: 1,
        column: 1,
        fnName: "css: modifiers ---- hover on md breakpoint",
    );
    matches(path(loc));
}

test "snapshots: path ---- named second snapshot" {
    val loc = SourceLocation(
        file: "test/router_test.bp",
        line: 1,
        column: 1,
        fnName: "route: two tables",
    );
    matches(pathNamed(loc, "After Merge"));
}

test "snapshots: slug ---- punctuation collapses to one underscore" {
    matches(slugOf("Modifiers ---- Hover, on (md) breakpoint!"));
}

test "snapshots: path ---- a name without a suite is refused" {
    val loc = SourceLocation(
        file: "src/a.bp",
        line: 1,
        column: 1,
        fnName: "no suite here",
    );
    val r = placeAs(loc, "text", "x");
    matches(errorText(r));
}

test "snapshots: name ---- the running test names the first snapshot" {
    matches("first");
}

test "snapshots: name ---- the running test names the second snapshot" {
    matches("second");
}

test "snapshots: path ---- the pure half" {
    assert suiteOf("css: modifiers ---- hover") == "css";
    assert suiteOf("no suite") == "";
    assert slugOf("modifiers ---- hover on md breakpoint")
        == "modifiers_hover_on_md_breakpoint";
    assert slugOf("  Leading and trailing  ") == "leading_and_trailing";
    assert slugOf("!!!") == "";
    val bare = SourceLocation(
        file: "main.bp",
        line: 1,
        column: 1,
        fnName: "t: bare file",
    );
    assert path(bare) == "__snapshots__/t/bare_file.snap";
}

test "snapshots: engine ---- missing writes a .new and answers Error" {
    val dir = tmpDir();
    val loc = SourceLocation(
        file: [dir, "/t.bp"].join(""),
        line: 1,
        column: 1,
        fnName: "e: missing",
    );
    val r = placeAs(loc, "text", "hello");
    assert r.isError();
    assert fs.exists([path(loc), ".new"].join(""));
    assert fs.exists(path(loc)) == false;
    assert errorText(r).startsWith("snapshots: missing ");
    val candidate = fs.readText([path(loc), ".new"].join("")).unwrapOr("");
    assert candidate
        == "botopink-snap 1\ntest: e: missing\nsubject: text\n\nhello\n";
    val cleaned = fs.removeTree(dir);
    assert cleaned.isOk();
}

test "snapshots: engine ---- mismatch writes a .new and answers Error" {
    val dir = tmpDir();
    val loc = SourceLocation(
        file: [dir, "/t.bp"].join(""),
        line: 1,
        column: 1,
        fnName: "e: mismatch",
    );
    val w = writeFile(path(loc), render("e: mismatch", "text", "old"));
    assert w.isOk();
    val r = placeAs(loc, "text", "new");
    assert r.isError();
    assert errorText(r).startsWith("snapshots: mismatch ");
    assert errorText(r).contains("(first difference at body line 1)");
    val candidate = fs.readText([path(loc), ".new"].join("")).unwrapOr("");
    assert candidate
        == "botopink-snap 1\ntest: e: mismatch\nsubject: text\n\nnew\n";
    val cleaned = fs.removeTree(dir);
    assert cleaned.isOk();
}

test "snapshots: engine ---- the differing line is counted from the body" {
    val dir = tmpDir();
    val loc = SourceLocation(
        file: [dir, "/t.bp"].join(""),
        line: 1,
        column: 1,
        fnName: "e: line",
    );
    val w = writeFile(path(loc), render("e: line", "text", "a\nb\nc"));
    assert w.isOk();
    val r = placeAs(loc, "text", "a\nb\nd");
    assert errorText(r).contains("(first difference at body line 3)");
    val cleaned = fs.removeTree(dir);
    assert cleaned.isOk();
}

test "snapshots: engine ---- match answers Ok and removes a stale .new" {
    val dir = tmpDir();
    val loc = SourceLocation(
        file: [dir, "/t.bp"].join(""),
        line: 1,
        column: 1,
        fnName: "e: match",
    );
    val w = writeFile(path(loc), render("e: match", "text", "same"));
    assert w.isOk();
    val stale = writeFile([path(loc), ".new"].join(""), "stale");
    assert stale.isOk();
    try placeAs(loc, "text", "same");
    assert fs.exists([path(loc), ".new"].join("")) == false;
    val cleaned = fs.removeTree(dir);
    assert cleaned.isOk();
}

test "snapshots: engine ---- header must match too" {
    val dir = tmpDir();
    val loc = SourceLocation(
        file: [dir, "/t.bp"].join(""),
        line: 1,
        column: 1,
        fnName: "e: header",
    );
    val w = writeFile(path(loc), render("e: header", "css", "body"));
    assert w.isOk();
    val r = placeAs(loc, "text", "body");
    assert r.isError();
    assert errorText(r).contains("(header differs)");
    val cleaned = fs.removeTree(dir);
    assert cleaned.isOk();
}

test "snapshots: engine ---- CRLF in the recorded file still matches" {
    val dir = tmpDir();
    val loc = SourceLocation(
        file: [dir, "/t.bp"].join(""),
        line: 1,
        column: 1,
        fnName: "e: crlf",
    );
    val w = writeFile(
        path(loc),
        "botopink-snap 1\r\ntest: e: crlf\r\nsubject: text\r\n\r\nline one\r\nline two\r\n",
    );
    assert w.isOk();
    try placeAs(loc, "text", "line one\nline two");
    val cleaned = fs.removeTree(dir);
    assert cleaned.isOk();
}

test "snapshots: engine ---- trailing newlines of the body do not matter" {
    val dir = tmpDir();
    val loc = SourceLocation(
        file: [dir, "/t.bp"].join(""),
        line: 1,
        column: 1,
        fnName: "e: trailing",
    );
    val w = writeFile(path(loc), render("e: trailing", "text", "body\n\n"));
    assert w.isOk();
    try placeAs(loc, "text", "body");
    val cleaned = fs.removeTree(dir);
    assert cleaned.isOk();
}

test "snapshots: engine ---- not a snapshot file" {
    val dir = tmpDir();
    val loc = SourceLocation(
        file: [dir, "/t.bp"].join(""),
        line: 1,
        column: 1,
        fnName: "e: magic",
    );
    val w = writeFile(path(loc), "hello\nworld\n\n\n");
    assert w.isOk();
    val r = placeAs(loc, "text", "x");
    assert r.isError();
    assert errorText(r).startsWith("snapshots: not a snapshot file");
    assert fs.exists([path(loc), ".new"].join("")) == false;
    val cleaned = fs.removeTree(dir);
    assert cleaned.isOk();
}

test "snapshots: engine ---- the header keeps the full test name" {
    val dir = tmpDir();
    val loc = SourceLocation(
        file: [dir, "/t.bp"].join(""),
        line: 1,
        column: 1,
        fnName: "css: modifiers ---- hover on md breakpoint",
    );
    val first = placeAs(
        loc,
        "css",
        "@media(min-width:768px){:hover{background:red}}",
    );
    assert first.isError();
    val text = fs.readText([path(loc), ".new"].join("")).unwrapOr("");
    assert text.contains("test: css: modifiers ---- hover on md breakpoint");
    assert text.contains("subject: css");
    assert path(loc).endsWith(
        "/__snapshots__/css/modifiers_hover_on_md_breakpoint.snap",
    );
    val cleaned = fs.removeTree(dir);
    assert cleaned.isOk();
}

test "snapshots: engine ---- a named snapshot lives beside the unnamed one" {
    val dir = tmpDir();
    val loc = SourceLocation(
        file: [dir, "/t.bp"].join(""),
        line: 1,
        column: 1,
        fnName: "e: named",
    );
    val w = writeFile(
        pathNamed(loc, "After Merge"),
        render("e: named", "text", "second"),
    );
    assert w.isOk();
    try placeNamedAs(loc, "After Merge", "text", "second");
    assert pathNamed(loc, "After Merge").endsWith(
        "/__snapshots__/e/named.after_merge.snap",
    );
    val empty = placeNamedAs(loc, "", "text", "x");
    assert empty.isError();
    assert errorText(empty).startsWith(
        "snapshots: a named snapshot needs a name",
    );
    val cleaned = fs.removeTree(dir);
    assert cleaned.isOk();
}

test "snapshots: engine ---- a module-level location is refused" {
    val loc = SourceLocation(file: "src/a.bp", line: 1, column: 1, fnName: "");
    val r = placeAs(loc, "text", "x");
    assert r.isError();
    assert errorText(r).startsWith("snapshots: test name needs a suite");
}
