//// Decision 784 — `snap.matchesRefused` records the refusals `compiler.load`
//// answers for a file: one block per `Diagnostic` (`refused <message>`,
//// `at <file>:<line>:<column>`, `label <text>` when there is one), subject
//// `refused`, through snap's path rule and `.new` flow. A file that compiles
//// fails the test; that case is not a test here (a red test would be
//// committed), see `docs.md`.

import {compiler} from "std";
import {matchesRefused} from "snap";

test "refused: a type mismatch is recorded" {
    matchesRefused(comptime compiler.load("cases/type_mismatch/main.bp"));
}

test "refused: a parse error is recorded with its label" {
    matchesRefused(comptime compiler.load("cases/unclosed/main.bp"));
}
