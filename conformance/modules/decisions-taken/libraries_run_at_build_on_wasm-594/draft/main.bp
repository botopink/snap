//// Decision 594 — Every library runs at build on the wasm comptime runtime (434), jhonstart first; a function only Erlang or Node can run is a located error there.

import {io.terminal} from "std";
import {snap, slugOf, suiteOf} from "snap";

pub fn main() -> void {
    val slug = comptime slugOf("Modifiers ---- Hover, on (md) breakpoint!");
    val suite = comptime suiteOf("css: modifiers ---- hover on md breakpoint");
    terminal.print(slug, "\n", suite, "\n");
}

test "css: modifiers ---- hover on md breakpoint" {
    snap.matches(comptime slugOf("Modifiers ---- Hover, on (md) breakpoint!"));
}
