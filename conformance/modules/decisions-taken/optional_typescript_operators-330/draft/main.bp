//// Decision 330 — `?T` is read with TypeScript's operators and has no methods; `result` goes; a type declared in a type is its associated type.

import {io.terminal, io.env, io.os, io.fs} from "std";
import {snap, suiteOf} from "snap";

// The suite of a test name, `null` when the name has none.
fn suiteOrNull(testName: string) -> ?string {
    val suite = suiteOf(testName);
    return if (suite == "") null else suite;
}

pub fn main() -> void {
    val base = env.read("BOTOPINK_TEST_TMPDIR") ?? os.tmpdir();
    terminal.print(base != "", "\n");

    val suite = suiteOrNull("css: modifiers ---- hover");
    val width = suite?.length() ?? 0;
    terminal.print(suite!, " ", width, "\n");

    val none = suiteOrNull("no suite here");
    terminal.print(none ?? "(no suite)", " ", none?.length() ?? 0, "\n");

    val recorded = fs.readText("src/__snapshots__/css/missing.snap");
    terminal.print(recorded.isError(), " ", recorded.unwrapOr("(no snapshot)"), "\n");
}

test "optional: a name with no suite" {
    snap.matches(suiteOrNull("no suite here") ?? "(no suite)");
}
