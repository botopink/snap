//// Decision 206 — `import {…} from "<name>"` resolves only to a package — std, a bundled package or a declared dependency.

import {io.terminal} from "std";
import {snap} from "snap";
import {snap.describe};

pub fn main() -> void {
    terminal.print(describe("css: modifiers ---- hover on md breakpoint"), "\n");
}

test "css: modifiers ---- hover on md breakpoint" {
    snap.matches(describe("css: modifiers ---- hover on md breakpoint"));
}
