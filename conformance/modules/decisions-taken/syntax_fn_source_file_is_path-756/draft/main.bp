//// Decision 756 — (a): `compiler.source(value).file` is the file, relative to the package root, as diagnostics print it — `src/main.bp` — never the module path.

import {compiler, compiler.Call, compiler.Name, compiler.Lit} from "std";
import {io.terminal} from "std";
import {snap} from "snap";

// The run-time half: the place the expansion wrote, and where snap puts the
// snapshot a test named `css: modifiers ---- hover` takes there.
pub fn placeAt(file: string, line: i32) -> void {
    terminal.print(file + ":" + line.toString());
    val loc = SourceLocation(file: file, line: line, column: 1, fnName: "css: modifiers ---- hover");
    terminal.print(snap.path(loc));
}

// Expanded at its call: `compiler.source(value).file` is the caller's file,
// relative to the package root.
pub fn placeOf(syntax value: unknown) -> anyvalue {
    val at = compiler.source(value);
    return compiler.ast(Call(callee: Name("placeAt"), args: [Lit(at.file), Lit(at.line)]));
}

pub fn main() -> void {
    placeOf("a:hover");
}
