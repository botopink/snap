//// Decision 563 — An `FsError` carries its own text: std's `io/fs` gives it `message()`

import {io.terminal, io.fs} from "std";
import {snap} from "snap";

// A recorded snapshot's text; an `io.fs` failure carried into the engine's
// `string` error by the error's own text.
fn readRecorded(file: string) -> Result<string, string> {
    val text = try fs.readText(file) catch { e ->
        throw ["snapshots: cannot read ", e.message()].join("");
    };
    return text;
}

fn textOf(file: string) -> string {
    return try readRecorded(file) catch { e -> e };
}

pub fn main() -> void {
    terminal.print(textOf("src/missing/__snapshots__/css/hover.snap"), "\n");
    terminal.print(textOf("."), "\n");
}

test "fs: a snapshot that is not there" {
    snap.matches(textOf("src/missing/__snapshots__/css/hover.snap"));
}
