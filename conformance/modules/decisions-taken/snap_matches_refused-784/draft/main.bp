//// Decision 784 — A refused case's snapshot is written by the `snap` library from the data `compiler.load` answers; `botopink cell check` no longer records refusals of the cases a module loads; amends 781 (1)–(3), keeps 780 (3) (no `compiler.snapshot`).

import {compiler} from "std";
import {snap} from "snap";

// The refused file is loaded at build; the answer is the snapshot's body:
// `refused <message>`, `at <file>:<line>:<column>`, `label <text>` when there is one.
test "refused: a type mismatch is recorded" {
    snap.matchesRefused(comptime compiler.load("cases/type_mismatch/main.bp"));
}

pub fn main() -> void {}
